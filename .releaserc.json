{
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", {
      "prepareCmd": "uv run -q python scripts/update_version.py ${nextRelease.version} && uv build",
      "publishCmd": "export VERSION=${nextRelease.version} && bash scripts/publish.sh"
    }],
    ["@ross/semantic-release-forgejo", {
      "forgejoUrl": "https://git.reslate.solutions"
    }]
  ]
}
